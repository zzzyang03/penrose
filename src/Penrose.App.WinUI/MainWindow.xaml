<Window
  x:Class="Penrose.App.WinUI.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Penrose.App.WinUI">
  <!-- Chrome is always dark: it floats over the picture. -->
  <Grid x:Name="Root" AllowDrop="True" Background="{StaticResource TransparentBrush}" RequestedTheme="Dark">
    <Grid.Resources>
      <DataTemplate x:Key="PlaylistRowTemplate" x:DataType="local:PlaylistRow">
        <Grid ColumnSpacing="12" Opacity="{x:Bind Opacity}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{x:Bind Indicator}"
                     FontFamily="{x:Bind IndicatorFont}"
                     FontSize="12"
                     Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Column="1"
                     Text="{x:Bind Name}"
                     Style="{StaticResource BodyText}"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" />
        </Grid>
      </DataTemplate>

      <!-- Poster wall tile: art (or a glyph placeholder), resume bar, title, subtitle. -->
      <DataTemplate x:Key="PosterTileTemplate" x:DataType="local:PosterRow">
        <StackPanel Width="{x:Bind TileWidth, Mode=OneWay}" Spacing="6" AutomationProperties.Name="{x:Bind Title}">
          <Grid Height="{x:Bind ImageHeight, Mode=OneWay}" CornerRadius="8" Background="{StaticResource HoverFillBrush}">
            <FontIcon Glyph="{x:Bind PlaceholderGlyph}"
                      FontSize="26"
                      Foreground="{StaticResource TextTertiaryBrush}"
                      Visibility="{x:Bind PlaceholderVisibility}" />
            <Image Source="{x:Bind Image}" Stretch="UniformToFill" />
            <Border Background="#CC52B54B"
                    CornerRadius="10"
                    Width="20"
                    Height="20"
                    Margin="0,6,6,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Visibility="{x:Bind PlayedVisibility}">
              <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="White" />
            </Border>
            <!-- Resume affordance: label over the art, thin bar along the bottom edge. -->
            <Border Background="#CC000000"
                    CornerRadius="4"
                    Padding="6,2"
                    Margin="6,0,0,10"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Visibility="{x:Bind ProgressVisibility}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <FontIcon Glyph="&#xE768;" FontSize="9" Foreground="White" VerticalAlignment="Center" />
                <TextBlock Text="{x:Bind ResumeLabel}" Foreground="White" FontSize="10.5" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <ProgressBar Value="{x:Bind Progress}"
                         Minimum="0"
                         Maximum="100"
                         Height="4"
                         MinHeight="4"
                         VerticalAlignment="Bottom"
                         Margin="0"
                         Background="#66000000"
                         Visibility="{x:Bind ProgressVisibility}" />
          </Grid>
          <TextBlock Text="{x:Bind Title}"
                     Style="{StaticResource BodyText}"
                     FontSize="13"
                     TextTrimming="CharacterEllipsis"
                     TextWrapping="NoWrap" />
          <TextBlock Text="{x:Bind Subtitle}"
                     Style="{StaticResource SecondaryText}"
                     FontSize="11.5"
                     TextTrimming="CharacterEllipsis"
                     TextWrapping="NoWrap"
                     Visibility="{x:Bind SubtitleVisibility}" />
        </StackPanel>
      </DataTemplate>

      <!-- Cells are sized by the window (see LayoutPosterGrid); the tile sits centred in its cell. -->
      <Style x:Key="PosterGridViewItem" TargetType="GridViewItem">
        <Setter Property="Margin" Value="0,0,0,18" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="Transparent" />
      </Style>
      <!-- The horizontal strip keeps fixed cells with a plain gap. -->
      <Style x:Key="StripGridViewItem" TargetType="GridViewItem" BasedOn="{StaticResource PosterGridViewItem}">
        <Setter Property="Margin" Value="0,0,14,0" />
      </Style>

      <DataTemplate x:Key="RecentRowTemplate" x:DataType="local:RecentRow">
        <Grid ColumnSpacing="12" AutomationProperties.Name="{x:Bind Name}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <FontIcon Glyph="&#xE8A5;" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" />
          <TextBlock Grid.Column="1"
                     Text="{x:Bind Name}"
                     Style="{StaticResource HomeRowText}"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Column="2"
                     Text="{x:Bind Detail}"
                     Style="{StaticResource HomeRowShortcut}"
                     VerticalAlignment="Center" />
        </Grid>
      </DataTemplate>

      <!-- Cast / crew card: portrait, name, role. -->
      <DataTemplate x:Key="PersonTileTemplate" x:DataType="local:PersonRow">
        <StackPanel Width="124" Spacing="6" AutomationProperties.Name="{x:Bind Name}">
          <Grid Height="166" CornerRadius="8" Background="{StaticResource HoverFillBrush}">
            <FontIcon Glyph="&#xE77B;" FontSize="34" Foreground="{StaticResource TextTertiaryBrush}" />
            <Image Source="{x:Bind Image}" Stretch="UniformToFill" />
          </Grid>
          <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyText}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextAlignment="Center" />
          <TextBlock Text="{x:Bind Role}" Style="{StaticResource SecondaryText}" FontSize="12" TextTrimming="CharacterEllipsis" TextAlignment="Center" />
        </StackPanel>
      </DataTemplate>

      <!-- Backdrop thumbnail in the art strip. -->
      <DataTemplate x:Key="ArtTileTemplate" x:DataType="local:ArtRow">
        <Grid Width="232" Height="130" CornerRadius="8" Background="{StaticResource HoverFillBrush}">
          <Image Source="{x:Bind Image}" Stretch="UniformToFill" />
        </Grid>
      </DataTemplate>

      <!-- Saved media server: kind icon, name, account@host, connected mark, remove. -->
      <DataTemplate x:Key="ServerRowTemplate" x:DataType="local:ServerRow">
        <Grid ColumnSpacing="12" Padding="4,6" AutomationProperties.Name="{x:Bind Name}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Image Source="{x:Bind IconSource}" Width="28" Height="28" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <Border Background="#3352B54B" CornerRadius="4" Padding="6,1" VerticalAlignment="Center" Visibility="{x:Bind ActiveVisibility}">
                <TextBlock Text="{x:Bind ActiveText}" FontSize="10.5" Foreground="#FF9BE58F" />
              </Border>
            </StackPanel>
            <TextBlock Text="{x:Bind Detail}" Style="{StaticResource SecondaryText}" FontSize="12" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Button Grid.Column="2"
                  Style="{StaticResource IconButton}"
                  Width="28"
                  Height="28"
                  MinWidth="28"
                  VerticalAlignment="Center"
                  Click="OnRemoveServerClick"
                  Tag="{x:Bind Server}"
                  AutomationProperties.Name="{x:Bind RemoveText}"
                  ToolTipService.ToolTip="{x:Bind RemoveText}">
            <FontIcon Glyph="&#xE74D;" FontSize="13" />
          </Button>
        </Grid>
      </DataTemplate>
    </Grid.Resources>

    <!-- Hidden on home / library so the window acrylic can show through. -->
    <SwapChainPanel x:Name="VideoPanel" Margin="-2,0" Visibility="Collapsed" />

    <!-- Home: brand / server column on the left, open actions and recent files on the right. -->
    <Grid x:Name="EmptyState" Background="{StaticResource PageGlassBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Left column -->
      <Grid x:Name="HomeLeft" Background="{StaticResource HomeColumnGlassBrush}" Padding="0,56,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Brand + the media-server entry under the version. -->
        <StackPanel x:Name="BrandPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Margin="24,0,24,8">
          <Image Source="ms-appx:///Assets/AppIcon.png"
                 Width="112"
                 Height="112"
                 HorizontalAlignment="Center"
                 Margin="0,0,0,10"
                 Stretch="Uniform" />
          <TextBlock x:Name="BrandTitle" Text="Penrose" Style="{StaticResource HeadlineText}" FontSize="24" HorizontalAlignment="Center" />
          <TextBlock x:Name="BrandVersion" Style="{StaticResource SecondaryText}" FontSize="13" HorizontalAlignment="Center" />
          <Button x:Name="ServersButton"
                  HorizontalAlignment="Center"
                  Margin="0,10,0,0"
                  Padding="18,8"
                  CornerRadius="18"
                  Background="{StaticResource HoverFillBrush}"
                  BorderThickness="0">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <!-- NAS icon: a 1024-unit SVG shifted to the origin; the Viewbox scales it to glyph size. -->
              <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                <PathIcon Data="F1 M 790 0 H 72.4 c -39.6 0 -71.9 32.2 -72 71.7 -0.3 2.7 -0.4 5.5 -0.4 8.2 v 607.6 c 0 2.8 0.1 5.5 0.4 8.3 0.2 39.5 32.4 71.7 72 71.7 h 4.6 c 1 0 2 0.1 3 0.1 h 29 c 1 0 2 0 3 -0.1 h 678 c 39.7 0 72 -32.3 72 -72 V 72 c 0 -39.7 -32.3 -72 -72 -72 z m -220 72 v 623.6 H 417.5 V 72 H 570 z M 94.5 319.1 c -19.9 0 -36 -16.1 -36 -36 s 16.1 -36 36 -36 36 16.1 36 36 -16.1 36 -36 36 z m 0 -118.3 c -19.9 0 -36 -16.1 -36 -36 s 16.1 -36 36 -36 36 16.1 36 36 -16.1 36 -36 36 z M 188.6 72 h 157 v 623.6 h -157 c 0.3 -2.6 0.4 -5.3 0.4 -7.9 V 80 c 0 -2.7 -0.2 -5.4 -0.4 -8 z M 790 695.6 H 642 V 72 h 148 v 623.6 z M 231.8 128.3 h 72 v 120 h -72 z M 457.8 128.3 h 72 v 120 h -72 z M 679.2 128.3 h 72 v 120 h -72 z" />
              </Viewbox>
              <TextBlock x:Name="ServersButtonText" Style="{StaticResource BodyText}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- Servers (replaces the brand when opened) -->
        <Grid x:Name="ServersPanel" Visibility="Collapsed" Padding="12,4,12,8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid ColumnSpacing="4" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="ServersBackButton" Style="{StaticResource IconButton}" Width="32" Height="32" MinWidth="32">
              <FontIcon Glyph="&#xE72B;" FontSize="14" />
            </Button>
            <TextBlock x:Name="ServersTitle" Grid.Column="1" Style="{StaticResource TitleText}" VerticalAlignment="Center" />
          </Grid>
          <ListView x:Name="ServerList"
                    Grid.Row="1"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemTemplate="{StaticResource ServerRowTemplate}"
                    ItemContainerStyle="{StaticResource PaneListViewItem}" />
          <TextBlock x:Name="ServersEmpty" Grid.Row="1" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="12,8,12,0" Visibility="Collapsed" />
          <Button x:Name="AddServerButton" Grid.Row="2" HorizontalAlignment="Stretch" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE710;" FontSize="14" />
              <TextBlock x:Name="AddServerText" />
            </StackPanel>
          </Button>
        </Grid>

        <!-- Sidebar footer: muted gear + label, same shape as the reference app. -->
        <Button x:Name="HomeSettingsButton"
                Grid.Row="1"
                Style="{StaticResource SidebarLinkButton}"
                Margin="0,4,0,8">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- Same line box as the label so the glyph sits on one baseline. -->
            <TextBlock FontFamily="Segoe Fluent Icons"
                       Text="&#xE713;"
                       FontSize="15"
                       LineHeight="20"
                       LineStackingStrategy="BlockLineHeight"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="HomeSettingsText"
                       Grid.Column="1"
                       FontSize="13"
                       LineHeight="20"
                       LineStackingStrategy="BlockLineHeight"
                       VerticalAlignment="Center" />
          </Grid>
        </Button>
      </Grid>

      <!-- Right column -->
      <Grid x:Name="HomeRight" Grid.Column="1" Padding="40,64,40,40">
        <!-- Open actions + recent files -->
        <StackPanel x:Name="OpenPanel" Spacing="2" VerticalAlignment="Top" MaxWidth="720" HorizontalAlignment="Stretch">
          <StackPanel.RenderTransform>
            <TranslateTransform />
          </StackPanel.RenderTransform>
          <Button x:Name="EmptyOpenFile" Style="{StaticResource HomeRowButton}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="EmptyOpenFileText" Style="{StaticResource HomeRowText}" />
              <TextBlock Grid.Column="1" Text="Ctrl+O" Style="{StaticResource HomeRowShortcut}" />
            </Grid>
          </Button>
          <Button x:Name="EmptyOpenUrl" Style="{StaticResource HomeRowButton}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="EmptyOpenUrlText" Style="{StaticResource HomeRowText}" />
              <TextBlock Grid.Column="1" Text="Ctrl+U" Style="{StaticResource HomeRowShortcut}" />
            </Grid>
          </Button>
          <Button x:Name="EmptyOpenFolder" Style="{StaticResource HomeRowButton}">
            <TextBlock x:Name="EmptyOpenFolderText" Style="{StaticResource HomeRowText}" />
          </Button>
          <Button x:Name="ResumeLastButton" Style="{StaticResource HomeRowButton}" Margin="0,18,0,0" Visibility="Collapsed">
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <FontIcon Glyph="&#xE823;" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
              <TextBlock x:Name="ResumeLastText" Grid.Column="1" Style="{StaticResource HomeRowText}" TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="ResumeLastDetail" Grid.Column="2" Style="{StaticResource HomeRowShortcut}" />
            </Grid>
          </Button>
          <ListView x:Name="RecentView"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemTemplate="{StaticResource RecentRowTemplate}"
                    ItemContainerStyle="{StaticResource HomeListViewItem}"
                    Margin="0,10,0,0"
                    MaxHeight="360"
                    Visibility="Collapsed" />
        </StackPanel>

        <!-- Server form (add / edit) -->
        <ScrollViewer x:Name="ServerFormPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ScrollViewer.RenderTransform>
            <TranslateTransform />
          </ScrollViewer.RenderTransform>
          <StackPanel Spacing="14" Width="520" HorizontalAlignment="Left">
            <TextBlock x:Name="ServerFormTitle" Style="{StaticResource HeadlineText}" FontSize="20" />
            <TextBox x:Name="ServerNameBox" />
            <ComboBox x:Name="ServerKindBox" HorizontalAlignment="Stretch" />
            <TextBox x:Name="ServerHostBox" />
            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="ServerPortBox" />
              <CheckBox x:Name="ServerHttpsBox" Grid.Column="1" VerticalAlignment="Bottom" MinWidth="0" />
            </Grid>
            <TextBox x:Name="ServerUserBox" />
            <PasswordBox x:Name="ServerPasswordBox" />
            <TextBlock x:Name="ServerFormStatus" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
              <Button x:Name="ServerTestButton" MinWidth="120">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon Glyph="&#xE774;" FontSize="14" />
                  <TextBlock x:Name="ServerTestText" />
                </StackPanel>
              </Button>
              <Button x:Name="ServerConnectButton" Style="{StaticResource AccentButtonStyle}" MinWidth="120">
                <TextBlock x:Name="ServerConnectText" />
              </Button>
              <Button x:Name="ServerCancelButton">
                <TextBlock x:Name="ServerCancelText" />
              </Button>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- Stays in this column; HomeRight padding is the left/right inset. -->
        <Grid x:Name="SettingsPanel"
              Visibility="Collapsed"
              Background="{StaticResource TransparentBrush}">
          <Grid.RenderTransform>
            <TranslateTransform />
          </Grid.RenderTransform>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel Spacing="12" Margin="0,0,0,16">
            <Button x:Name="SettingsBackButton"
                    Style="{StaticResource SidebarLinkButton}"
                    HorizontalAlignment="Left"
                    Padding="8,6"
                    Margin="-8,0,0,0">
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock FontFamily="Segoe Fluent Icons"
                           Text="&#xE72B;"
                           FontSize="15"
                           LineHeight="20"
                           LineStackingStrategy="BlockLineHeight"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="SettingsBackText"
                           Grid.Column="1"
                           FontSize="13"
                           LineHeight="20"
                           LineStackingStrategy="BlockLineHeight"
                           VerticalAlignment="Center" />
              </Grid>
            </Button>
            <TextBlock x:Name="SettingsTitle" Style="{StaticResource HeadlineText}" FontSize="20" />
          </StackPanel>
          <ScrollViewer x:Name="SettingsScroll"
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled">
            <StackPanel x:Name="SettingsHost" Spacing="12" HorizontalAlignment="Stretch" />
          </ScrollViewer>
        </Grid>
      </Grid>
    </Grid>

    <!-- Emby page: a full screen of posters under the title bar; folders drill in, items play. -->
    <Grid x:Name="EmbyPage"
          Background="{StaticResource PageGlassBrush}"
          Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Item page (movie / episode / series / season / box set): one scrolling column,
           drawn under the header row so the backdrop runs up to the window edge. -->
      <ScrollViewer x:Name="DetailsScroll"
                    Grid.RowSpan="3"
                    Visibility="Collapsed"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <!-- Hero: backdrop fading into the page, poster + facts over its lower part. -->
          <Grid x:Name="Hero">
            <Image x:Name="DetailsBackdrop" Height="480" Stretch="UniformToFill" VerticalAlignment="Top" />
            <Border Height="480" VerticalAlignment="Top">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="#B30D0D12" Offset="0" />
                  <GradientStop Color="#330D0D12" Offset="0.3" />
                  <GradientStop Color="#990D0D12" Offset="0.6" />
                  <GradientStop Color="#FF0D0D12" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>
            <Grid x:Name="HeroInfo" Margin="40,300,40,0" ColumnSpacing="28">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border x:Name="DetailsPosterBox" Width="200" Height="300" CornerRadius="8" Background="{StaticResource HoverFillBrush}" VerticalAlignment="Top">
                <Grid>
                  <FontIcon Glyph="&#xE714;" FontSize="40" Foreground="{StaticResource TextTertiaryBrush}" />
                  <Image x:Name="DetailsPoster" Stretch="UniformToFill" />
                </Grid>
              </Border>
              <StackPanel Grid.Column="1" Spacing="12" VerticalAlignment="Top" MaxWidth="960" HorizontalAlignment="Left">
                <TextBlock x:Name="DetailsTitle" Style="{StaticResource HeadlineText}" FontSize="32" TextWrapping="Wrap" />
                <!-- ★ 8.3 · [TV-MA] · Black Mirror · 2011 · 44 分钟 · 已完结 -->
                <StackPanel x:Name="DetailsFacts" Orientation="Horizontal" Spacing="12">
                  <StackPanel x:Name="DetailsRatingBox" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE735;" FontSize="13" Foreground="#FFF2C24B" />
                    <TextBlock x:Name="DetailsRating" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                  </StackPanel>
                  <Border x:Name="DetailsOfficialBox" BorderBrush="{StaticResource TextSecondaryBrush}" BorderThickness="1" CornerRadius="3" Padding="5,0" VerticalAlignment="Center">
                    <TextBlock x:Name="DetailsOfficialRating" Style="{StaticResource SecondaryText}" FontSize="11.5" />
                  </Border>
                  <TextBlock x:Name="DetailsMeta" Style="{StaticResource SecondaryText}" FontSize="13.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel x:Name="DetailsGenres" Orientation="Horizontal" Spacing="8" />
                <!-- Server-side flags, same as Emby's own page. -->
                <StackPanel x:Name="DetailsActions" Orientation="Horizontal" Spacing="8">
                  <ToggleButton x:Name="DetailsPlayedToggle" Style="{StaticResource ChipToggle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <FontIcon Glyph="&#xE73E;" FontSize="13" />
                      <TextBlock x:Name="DetailsPlayedText" />
                    </StackPanel>
                  </ToggleButton>
                  <ToggleButton x:Name="DetailsFavoriteToggle" Style="{StaticResource ChipToggle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <FontIcon x:Name="DetailsFavoriteGlyph" Glyph="&#xEB51;" FontSize="13" />
                      <TextBlock x:Name="DetailsFavoriteText" />
                    </StackPanel>
                  </ToggleButton>
                </StackPanel>
                <TextBlock x:Name="DetailsTagline" Style="{StaticResource SecondaryText}" FontStyle="Italic" TextWrapping="Wrap" Visibility="Collapsed" />
                <TextBlock x:Name="DetailsOverview" Style="{StaticResource BodyText}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" LineHeight="22" />
                <HyperlinkButton x:Name="DetailsOverviewMore" Padding="0" Margin="0,-6,0,0" FontSize="13" Visibility="Collapsed" />
                <!-- 首播 / 出品 -->
                <TextBlock x:Name="DetailsExtraFacts" Style="{StaticResource SecondaryText}" FontSize="12.5" TextWrapping="Wrap" Visibility="Collapsed" />
                <StackPanel x:Name="DetailsPlayRow" Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                  <Button x:Name="DetailsPlayButton" Style="{StaticResource AccentButtonStyle}" MinWidth="170" Padding="18,8" CornerRadius="{StaticResource RadiusMd}">
                    <Grid ColumnSpacing="10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <FontIcon Glyph="&#xE768;" FontSize="16" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" Spacing="1">
                        <TextBlock x:Name="DetailsPlayText" FontWeight="SemiBold" />
                        <TextBlock x:Name="DetailsPlaySub" FontSize="11.5" Opacity="0.85" Visibility="Collapsed" />
                      </StackPanel>
                    </Grid>
                  </Button>
                  <Button x:Name="DetailsRestartButton" Visibility="Collapsed" VerticalAlignment="Stretch" CornerRadius="{StaticResource RadiusMd}">
                    <TextBlock x:Name="DetailsRestartText" />
                  </Button>
                </StackPanel>
                <!-- Version / audio / subtitle pickers for playback, like the selectors on Emby's page.
                     Equal widths, spanning the same width as the text above. -->
                <Grid x:Name="DetailsMediaCards" ColumnSpacing="12" Margin="0,6,0,0" HorizontalAlignment="Stretch">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <DropDownButton x:Name="VideoCard" Style="{StaticResource MediaCardButton}">
                    <StackPanel Spacing="3">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE714;" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock x:Name="DetailsVideoTitle" Style="{StaticResource BodyText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <TextBlock x:Name="DetailsVideoDetail" Style="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                      <MenuFlyout x:Name="VideoFlyout" Placement="Bottom" />
                    </DropDownButton.Flyout>
                  </DropDownButton>
                  <DropDownButton x:Name="AudioCard" Grid.Column="1" Style="{StaticResource MediaCardButton}">
                    <StackPanel Spacing="3">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8D6;" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock x:Name="DetailsAudioTitle" Style="{StaticResource BodyText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <TextBlock x:Name="DetailsAudioDetail" Style="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                      <MenuFlyout x:Name="AudioFlyout" Placement="Bottom" />
                    </DropDownButton.Flyout>
                  </DropDownButton>
                  <DropDownButton x:Name="SubtitleCard" Grid.Column="2" Style="{StaticResource MediaCardButton}">
                    <StackPanel Spacing="3">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xED1E;" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock x:Name="DetailsSubtitleTitle" Style="{StaticResource BodyText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <TextBlock x:Name="DetailsSubtitleDetail" Style="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                      <MenuFlyout x:Name="SubtitleFlyout" Placement="Bottom" />
                    </DropDownButton.Flyout>
                  </DropDownButton>
                </Grid>
              </StackPanel>
            </Grid>
          </Grid>

          <!-- Sections below the hero, each a header and a strip / wall. Strips page with the ‹ › buttons. -->
          <StackPanel x:Name="DetailsSections" Margin="40,28,40,40" Spacing="28">
            <StackPanel x:Name="NextUpSection" Spacing="10" Visibility="Collapsed">
              <Grid>
                <TextBlock x:Name="NextUpHeader" Style="{StaticResource SectionHeaderText}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                  <Button x:Name="NextUpPrev" Style="{StaticResource StripArrow}"><FontIcon Glyph="&#xE76B;" FontSize="12" /></Button>
                  <Button x:Name="NextUpNext" Style="{StaticResource StripArrow}"><FontIcon Glyph="&#xE76C;" FontSize="12" /></Button>
                </StackPanel>
              </Grid>
              <GridView x:Name="NextUpList" Style="{StaticResource StripGridView}" ItemTemplate="{StaticResource PosterTileTemplate}" ItemContainerStyle="{StaticResource StripGridViewItem}" Height="204" />
            </StackPanel>
            <StackPanel x:Name="ChildrenSection" Spacing="10" Visibility="Collapsed">
              <TextBlock x:Name="ChildrenHeader" Style="{StaticResource SectionHeaderText}" />
              <!-- Non-scrolling wall inside the page scroll; sized by LayoutPosterGrid like the main wall. -->
              <GridView x:Name="DetailsChildren"
                        SelectionMode="None"
                        IsItemClickEnabled="True"
                        ItemTemplate="{StaticResource PosterTileTemplate}"
                        ItemContainerStyle="{StaticResource PosterGridViewItem}"
                        ScrollViewer.VerticalScrollMode="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Hidden"
                        ScrollViewer.HorizontalScrollMode="Disabled"
                        Padding="0">
                <GridView.ItemsPanel>
                  <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </GridView.ItemsPanel>
              </GridView>
            </StackPanel>
            <StackPanel x:Name="PeopleSection" Spacing="10" Visibility="Collapsed">
              <Grid>
                <TextBlock x:Name="PeopleHeader" Style="{StaticResource SectionHeaderText}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                  <Button x:Name="PeoplePrev" Style="{StaticResource StripArrow}"><FontIcon Glyph="&#xE76B;" FontSize="12" /></Button>
                  <Button x:Name="PeopleNext" Style="{StaticResource StripArrow}"><FontIcon Glyph="&#xE76C;" FontSize="12" /></Button>
                </StackPanel>
              </Grid>
              <GridView x:Name="PeopleList" Style="{StaticResource StripGridView}" ItemTemplate="{StaticResource PersonTileTemplate}" ItemContainerStyle="{StaticResource StripGridViewItem}" Height="232" IsItemClickEnabled="False" ScrollViewer.HorizontalScrollMode="Disabled" />
            </StackPanel>
            <StackPanel x:Name="ArtSection" Spacing="10" Visibility="Collapsed">
              <Grid>
                <TextBlock x:Name="ArtHeader" Style="{StaticResource SectionHeaderText}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                  <Button x:Name="ArtPrev" Style="{StaticResource StripArrow}"><FontIcon Glyph="&#xE76B;" FontSize="12" /></Button>
                  <Button x:Name="ArtNext" Style="{StaticResource StripArrow}"><FontIcon Glyph="&#xE76C;" FontSize="12" /></Button>
                </StackPanel>
              </Grid>
              <GridView x:Name="ArtList" Style="{StaticResource StripGridView}" ItemTemplate="{StaticResource ArtTileTemplate}" ItemContainerStyle="{StaticResource StripGridViewItem}" Height="150" IsItemClickEnabled="False" />
            </StackPanel>
            <StackPanel x:Name="SimilarSection" Spacing="10" Visibility="Collapsed">
              <Grid>
                <TextBlock x:Name="SimilarHeader" Style="{StaticResource SectionHeaderText}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                  <Button x:Name="SimilarPrev" Style="{StaticResource StripArrow}"><FontIcon Glyph="&#xE76B;" FontSize="12" /></Button>
                  <Button x:Name="SimilarNext" Style="{StaticResource StripArrow}"><FontIcon Glyph="&#xE76C;" FontSize="12" /></Button>
                </StackPanel>
              </Grid>
              <GridView x:Name="SimilarList" Style="{StaticResource StripGridView}" ItemTemplate="{StaticResource PosterTileTemplate}" ItemContainerStyle="{StaticResource StripGridViewItem}" Height="300" ScrollViewer.HorizontalScrollMode="Disabled" />
            </StackPanel>
            <StackPanel x:Name="LinksSection" Spacing="10" Visibility="Collapsed">
              <TextBlock x:Name="LinksHeader" Style="{StaticResource SectionHeaderText}" />
              <StackPanel x:Name="DetailsLinks" Orientation="Horizontal" Spacing="6" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- Backing for the header once the item page has scrolled under it: opacity follows
           the offset, and the lower edge always fades out instead of ending in a hard line. -->
      <Border x:Name="HeaderBackdrop" Opacity="0" IsHitTestVisible="False" Margin="0,0,0,-36">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF0D0D12" Offset="0" />
            <GradientStop Color="#F00D0D12" Offset="0.6" />
            <GradientStop Color="#000D0D12" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <Grid ColumnSpacing="8" Margin="24,60,24,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button x:Name="LibraryBackButton" Style="{StaticResource IconButton}" Visibility="Collapsed">
          <FontIcon Glyph="&#xE72B;" FontSize="16" />
        </Button>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="4,0,0,0">
          <TextBlock x:Name="LibraryHeader" Style="{StaticResource HeadlineText}" FontSize="20" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="LibraryCount" Style="{StaticResource SecondaryText}" FontSize="12" />
        </StackPanel>
        <!-- Ordering, only where the server sorts (library roots). -->
        <StackPanel x:Name="SortPanel" Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed">
          <DropDownButton x:Name="SortButton" Background="Transparent" BorderThickness="0">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE8CB;" FontSize="14" />
              <TextBlock x:Name="SortText" Style="{StaticResource BodyText}" />
            </StackPanel>
            <DropDownButton.Flyout>
              <MenuFlyout x:Name="SortFlyout" Placement="BottomEdgeAlignedRight" />
            </DropDownButton.Flyout>
          </DropDownButton>
          <Button x:Name="SortOrderButton" Style="{StaticResource IconButton}">
            <FontIcon x:Name="SortOrderGlyph" Glyph="&#xE74A;" FontSize="14" />
          </Button>
        </StackPanel>
        <StackPanel x:Name="LibrarySearchHost" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <Grid x:Name="LibrarySearchClip" Width="0" VerticalAlignment="Center">
            <TextBox x:Name="LibrarySearchBox" Width="252" MinWidth="0" Margin="0,0,8,0" Opacity="0" IsTabStop="False" IsHitTestVisible="False" />
          </Grid>
          <Button x:Name="LibrarySearchButton" Style="{StaticResource IconButton}" Click="OnLibrarySearchButtonClick">
            <FontIcon Glyph="&#xE721;" FontSize="16" />
          </Button>
        </StackPanel>
        <Button x:Name="LibraryAccountButton" Grid.Column="4" Style="{StaticResource IconButton}">
          <FontIcon Glyph="&#xE77B;" FontSize="16" />
        </Button>
      </Grid>
      <!-- Continue watching: in-progress items from the server, only on the top level. -->
      <StackPanel x:Name="ResumeSection" Grid.Row="1" Spacing="8" Margin="28,0,24,12" Visibility="Collapsed">
        <TextBlock x:Name="ResumeHeader" Style="{StaticResource SectionHeaderText}" />
        <!-- Same tile machinery as the wall (GridView), one row, scrolling sideways. -->
        <GridView x:Name="ResumeList" Style="{StaticResource StripGridView}" ItemTemplate="{StaticResource PosterTileTemplate}" ItemContainerStyle="{StaticResource StripGridViewItem}" Height="204" Padding="4,0,0,0" />
        <TextBlock x:Name="LibraryHeaderAll" Style="{StaticResource SectionHeaderText}" Margin="0,8,0,0" />
      </StackPanel>
      <StackPanel x:Name="LibraryMessagePanel" Grid.Row="2" Spacing="12" Margin="28,8,24,0" Visibility="Collapsed">
        <TextBlock x:Name="LibraryMessage" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" />
        <Button x:Name="LibraryConnectButton" Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE968;" FontSize="14" />
            <TextBlock x:Name="LibraryConnectText" />
          </StackPanel>
        </Button>
      </StackPanel>
      <GridView x:Name="PosterGrid"
                Grid.Row="2"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemTemplate="{StaticResource PosterTileTemplate}"
                ItemContainerStyle="{StaticResource PosterGridViewItem}"
                IncrementalLoadingTrigger="Edge"
                IncrementalLoadingThreshold="2"
                DataFetchSize="2"
                Padding="4,0,0,8"
                Margin="24,0,24,0">
        <GridView.ItemsPanel>
          <ItemsPanelTemplate>
            <ItemsWrapGrid Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </GridView.ItemsPanel>
      </GridView>
      <!-- Above the wall so it reads while a folder or a remote item is being opened. -->
      <Border x:Name="LibraryBusy"
              Grid.Row="2"
              Style="{StaticResource OsdPill}"
              Padding="16"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Visibility="Collapsed">
        <ProgressRing x:Name="LibraryBusyRing" Width="36" Height="36" IsActive="False" />
      </Border>
    </Grid>

    <!-- Banners (fullscreen fallback, bitstream hint, errors) stack under the top bar. -->
    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="16,56,16,0" Spacing="8" MaxWidth="720">
      <InfoBar x:Name="FallbackBanner" Severity="Warning" IsClosable="False" IsOpen="False">
        <InfoBar.ActionButton>
          <Button x:Name="LeaveFullButton" />
        </InfoBar.ActionButton>
      </InfoBar>
      <InfoBar x:Name="HintBanner" Severity="Informational" IsOpen="False" />
      <InfoBar x:Name="ErrorPanel" Severity="Error" IsOpen="False" />
    </StackPanel>

    <!-- Format chips (Dolby Vision / HDR10 / Dolby Atmos / 7.1 …), shown briefly after a file starts. -->
    <StackPanel x:Name="FormatBadgeStrip"
                Orientation="Horizontal"
                Spacing="10"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="16,60,0,0"
                Visibility="Collapsed"
                IsHitTestVisible="False" />

    <!-- Playback info overlay (I key / info button). -->
    <Border x:Name="InfoOverlay"
            Style="{StaticResource OverlayPanel}"
            Visibility="Collapsed"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,60,16,0"
            MaxWidth="460">
      <StackPanel Spacing="8">
        <TextBlock x:Name="InfoHeader" Style="{StaticResource SectionHeaderText}" />
        <TextBlock x:Name="StatusText" Style="{StaticResource MonoText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
      </StackPanel>
    </Border>

    <!-- OSD pill: short feedback (volume, seek, mode). -->
    <Border x:Name="OsdPanel"
            Style="{StaticResource OsdPill}"
            Visibility="Collapsed"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,128"
            IsHitTestVisible="False">
      <TextBlock x:Name="OsdText" Style="{StaticResource OsdText}" />
    </Border>

    <!-- Progress line while chrome is hidden / in PiP. -->
    <ProgressBar x:Name="MiniProgress"
                 Visibility="Collapsed"
                 VerticalAlignment="Bottom"
                 Height="3"
                 Minimum="0"
                 Maximum="1"
                 IsHitTestVisible="False"
                 Background="Transparent" />

    <!-- Top bar: title (drag region) + a few actions. Gradient scrim, no solid strip.
         The scrim itself is click-through: only the 48 px title row takes input, so
         page headers drawn under the gradient (home server list, Emby page) stay clickable. -->
    <Grid x:Name="TopBar" VerticalAlignment="Top" Height="96">
      <Border x:Name="TopScrim" Background="{StaticResource TopScrimBrush}" IsHitTestVisible="False" />
      <Grid VerticalAlignment="Top" Height="48" Padding="12,0,0,0" Background="Transparent">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <!-- Playback: stop and go back (item page for a server title, home for a local file). -->
        <Button x:Name="BackToLibraryButton" Style="{StaticResource IconButton}" Visibility="Collapsed" Margin="-4,0,6,0">
          <FontIcon Glyph="&#xE72B;" FontSize="16" />
        </Button>
        <Grid x:Name="TitleBarDrag" Grid.Column="1" Background="Transparent" VerticalAlignment="Stretch">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Image Source="ms-appx:///Assets/AppIcon.png" Width="16" Height="16" Stretch="Uniform" />
            <TextBlock x:Name="TitleText" Style="{StaticResource TitleText}" FontSize="12" MaxWidth="560" />
            <StackPanel x:Name="TitleBadges" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
        <StackPanel x:Name="TopActions" Grid.Column="2" Orientation="Horizontal" Spacing="0" VerticalAlignment="Stretch">
          <Button x:Name="SettingsButton" Style="{StaticResource CaptionBarButton}">
            <FontIcon Glyph="&#xE713;" FontSize="12" />
          </Button>
          <Button x:Name="InfoButton" Style="{StaticResource CaptionBarButton}" Visibility="Collapsed">
            <FontIcon Glyph="&#xE946;" FontSize="12" />
          </Button>
        </StackPanel>
      </Grid>
    </Grid>

    <!-- Seek thumbnail, positioned by code above the slider. -->
    <Border x:Name="ThumbPreview"
            Style="{StaticResource Pane}"
            Visibility="Collapsed"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            IsHitTestVisible="False"
            Padding="4"
            Margin="0,0,0,96">
      <StackPanel Spacing="4">
        <Border CornerRadius="4">
          <Image x:Name="ThumbImage" Width="160" Height="90" Stretch="UniformToFill" />
        </Border>
        <TextBlock x:Name="ThumbTime" Style="{StaticResource TimeText}" FontSize="12" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- Transport bar: scrim + slider + [play cluster | spacer | track/panel cluster]. -->
    <!-- Same rule as the top bar: the gradient is click-through, only the controls
         block (slider + buttons) takes input, so buttons of the pages underneath
         that reach into the fade (home "影视服务器", poster rows) stay clickable. -->
    <Grid x:Name="TransportBar" VerticalAlignment="Bottom" Height="136">
      <Border x:Name="BottomScrim" Background="{StaticResource BottomScrimBrush}" IsHitTestVisible="False" />
      <Grid VerticalAlignment="Bottom" Padding="16,0,16,10" RowSpacing="2" Background="Transparent">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Slider x:Name="PositionSlider"
                Minimum="0"
                Maximum="1"
                StepFrequency="0.001"
                IsThumbToolTipEnabled="False"
                Margin="0,0,0,-4" />
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <Button x:Name="PrevButton" Style="{StaticResource IconButton}">
              <SymbolIcon Symbol="Previous" />
            </Button>
            <Button x:Name="PlayButton" Style="{StaticResource PrimaryIconButton}" Margin="4,0">
              <SymbolIcon x:Name="PlayIcon" Symbol="Play" />
            </Button>
            <Button x:Name="NextButton" Style="{StaticResource IconButton}">
              <SymbolIcon Symbol="Next" />
            </Button>
            <Button x:Name="VolumeButton" Style="{StaticResource IconButton}" Margin="8,0,0,0">
              <SymbolIcon x:Name="VolumeIcon" Symbol="Volume" />
            </Button>
            <Slider x:Name="VolumeSlider"
                    Width="96"
                    Minimum="0"
                    Maximum="100"
                    Value="100"
                    IsThumbToolTipEnabled="False"
                    VerticalAlignment="Center" />
            <!-- Source → output channel layout; click to pick a downmix. -->
            <Button x:Name="ChannelsButton"
                    Style="{StaticResource IconButton}"
                    Width="Auto"
                    MinWidth="44"
                    Height="26"
                    Padding="9,0"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Background="{StaticResource HoverFillBrush}"
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
              <TextBlock x:Name="ChannelsText"
                         Style="{StaticResource TimeText}"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         FontSize="12"
                         VerticalAlignment="Center"
                         Text="—" />
            </Button>
            <!-- Dynamic-range indicator: lit for HDR10 / HDR10+ / HLG / Dolby Vision, dimmed for SDR. -->
            <Border x:Name="HdrChip"
                    Height="26"
                    Padding="9,0"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Background="{StaticResource HoverFillBrush}"
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Opacity="0.35"
                    Visibility="Collapsed">
              <TextBlock x:Name="HdrText"
                         Style="{StaticResource TimeText}"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         FontSize="12"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center"
                         Text="HDR" />
            </Border>
            <TextBlock x:Name="TimeText" Style="{StaticResource TimeText}" Margin="10,0,0,0" VerticalAlignment="Center" Text="00:00 / 00:00" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <Button x:Name="AudioButton" Style="{StaticResource IconButton}">
              <SymbolIcon Symbol="Audio" />
            </Button>
            <Button x:Name="SubButton" Style="{StaticResource IconButton}">
              <SymbolIcon Symbol="ClosedCaption" />
            </Button>
            <Button x:Name="ChapterButton" Style="{StaticResource IconButton}">
              <SymbolIcon Symbol="Bookmarks" />
            </Button>
            <Button x:Name="PlaylistButton" Style="{StaticResource IconButton}">
              <SymbolIcon Symbol="List" />
            </Button>
            <Rectangle Width="1" Height="20" Fill="{StaticResource DividerBrush}" Margin="6,0" />
            <Button x:Name="FullButton" Style="{StaticResource IconButton}">
              <SymbolIcon x:Name="FullIcon" Symbol="FullScreen" />
            </Button>
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>

    <!-- Playlist pane (right) -->
    <Border x:Name="PlaylistPane"
            Style="{StaticResource Pane}"
            Visibility="Collapsed"
            HorizontalAlignment="Right"
            Width="320"
            Margin="0,60,12,108"
            Padding="8">
      <Grid RowSpacing="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="8" Padding="8,4,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="PlaylistHeader" Style="{StaticResource TitleText}" />
          <Button x:Name="PlaylistCloseButton" Grid.Column="1" Style="{StaticResource IconButton}" Width="28" Height="28" MinWidth="28">
            <SymbolIcon Symbol="Cancel" />
          </Button>
        </Grid>
        <ListView x:Name="PlaylistView"
                  Grid.Row="1"
                  SelectionMode="Single"
                  IsItemClickEnabled="True"
                  ItemTemplate="{StaticResource PlaylistRowTemplate}"
                  ItemContainerStyle="{StaticResource PaneListViewItem}" />
      </Grid>
    </Border>
  </Grid>
</Window>
