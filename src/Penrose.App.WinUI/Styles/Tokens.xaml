<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Colour tokens. Chrome is always dark: it floats over video. -->
  <Color x:Key="ChromeBaseColor">#0B0B0F</Color>
  <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FF0B0B0F" />
  <!-- Thin veils over Desktop Acrylic so the system blur stays visible. -->
  <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />
  <SolidColorBrush x:Key="PageGlassBrush" Color="#8C0B0B0F" />
  <SolidColorBrush x:Key="HomeColumnBrush" Color="#FF111116" />
  <SolidColorBrush x:Key="HomeColumnGlassBrush" Color="#70111116" />
  <SolidColorBrush x:Key="PanelBrush" Color="#F5131318" />
  <SolidColorBrush x:Key="OverlayBrush" Color="#E0101015" />
  <SolidColorBrush x:Key="OsdBrush" Color="#B3000000" />
  <SolidColorBrush x:Key="DividerBrush" Color="#1FFFFFFF" />
  <SolidColorBrush x:Key="HoverFillBrush" Color="#1AFFFFFF" />
  <SolidColorBrush x:Key="PressedFillBrush" Color="#0DFFFFFF" />
  <SolidColorBrush x:Key="PrimaryFillBrush" Color="#26FFFFFF" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF4F4F7" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B3F4F4F7" />
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="#80F4F4F7" />
  <SolidColorBrush x:Key="TrackFillBrush" Color="#4DFFFFFF" />
  <SolidColorBrush x:Key="TrackFillHoverBrush" Color="#66FFFFFF" />

  <!-- Solid alpha: acrylic cannot sample the SwapChain picture, so it looked opaque. -->
  <SolidColorBrush x:Key="BadgeBackdropBrush" Color="#4034343A" />
  <SolidColorBrush x:Key="BadgeEdgeBrush" Color="#2EFFFFFF" />

  <!-- Gradient scrims instead of solid bars: the picture is never cut by an edge. -->
  <LinearGradientBrush x:Key="TopScrimBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#B3000000" Offset="0" />
    <GradientStop Color="#40000000" Offset="0.55" />
    <GradientStop Color="#00000000" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="BottomScrimBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#00000000" Offset="0" />
    <GradientStop Color="#59000000" Offset="0.45" />
    <GradientStop Color="#D9000000" Offset="1" />
  </LinearGradientBrush>

  <!-- Dialogs: the default 548-dip maximum clips the grouped settings page. -->
  <x:Double x:Key="ContentDialogMaxWidth">760</x:Double>
  <x:Double x:Key="ContentDialogMaxHeight">1000</x:Double>

  <!-- Spacing / radius scale -->
  <x:Double x:Key="SpaceXs">4</x:Double>
  <x:Double x:Key="SpaceSm">8</x:Double>
  <x:Double x:Key="SpaceMd">12</x:Double>
  <x:Double x:Key="SpaceLg">16</x:Double>
  <x:Double x:Key="SpaceXl">24</x:Double>
  <CornerRadius x:Key="RadiusSm">4</CornerRadius>
  <CornerRadius x:Key="RadiusMd">8</CornerRadius>
  <CornerRadius x:Key="RadiusPill">18</CornerRadius>

  <!-- Lightweight styling for every Slider under the window: thin track, accent
       value fill, small round thumb. Resolved through the element resource chain. -->
  <x:Double x:Key="SliderTrackThemeHeight">4</x:Double>
  <x:Double x:Key="SliderHorizontalThumbWidth">14</x:Double>
  <x:Double x:Key="SliderHorizontalThumbHeight">14</x:Double>
  <x:Double x:Key="SliderInsideTickBarThemeHeight">0</x:Double>
  <SolidColorBrush x:Key="SliderTrackFill" Color="#4DFFFFFF" />
  <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#66FFFFFF" />
  <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#66FFFFFF" />
  <SolidColorBrush x:Key="SliderTrackFillDisabled" Color="#26FFFFFF" />
  <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FFE6E6E6" />
  <SolidColorBrush x:Key="SliderThumbBackgroundDisabled" Color="#80FFFFFF" />
  <SolidColorBrush x:Key="SliderContainerBackground" Color="Transparent" />
  <SolidColorBrush x:Key="SliderContainerBackgroundPointerOver" Color="Transparent" />
  <SolidColorBrush x:Key="SliderContainerBackgroundPressed" Color="Transparent" />
</ResourceDictionary>
