<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Icon button: transparent, square, subtle hover. Content is a SymbolIcon / FontIcon. -->
  <Style x:Key="IconButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="MinWidth" Value="36" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root"
                Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{StaticResource HoverFillBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{StaticResource PressedFillBrush}" />
                    <Setter Target="Presenter.Opacity" Value="0.7" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Presenter.Opacity" Value="0.35" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ContentPresenter x:Name="Presenter"
                              Content="{TemplateBinding Content}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Same cell as Win11 min / max / close: fills the tall title bar, no gap. -->
  <Style x:Key="CaptionBarButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="48" />
    <Setter Property="MinWidth" Value="46" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <!-- Primary transport action (play/pause): larger, filled circle. -->
  <Style x:Key="PrimaryIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="MinWidth" Value="44" />
    <Setter Property="CornerRadius" Value="22" />
    <Setter Property="Background" Value="{StaticResource PrimaryFillBrush}" />
  </Style>

  <!-- Floating panels (side panes, info overlay, thumbnail preview). -->
  <Style x:Key="Pane" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
  </Style>

  <Style x:Key="OverlayPanel" TargetType="Border" BasedOn="{StaticResource Pane}">
    <Setter Property="Background" Value="{StaticResource OverlayBrush}" />
    <Setter Property="Padding" Value="16,12" />
  </Style>

  <!-- Sidebar footer link: small icon + label, pinned bottom-left (settings). -->
  <Style x:Key="SidebarLinkButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="Padding" Value="20,8" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root"
                Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{StaticResource HoverFillBrush}" />
                    <Setter Target="Presenter.Foreground" Value="{StaticResource TextPrimaryBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{StaticResource PressedFillBrush}" />
                    <Setter Target="Presenter.Opacity" Value="0.7" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Presenter.Opacity" Value="0.35" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ContentPresenter x:Name="Presenter"
                              Content="{TemplateBinding Content}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Home page rows: quiet full-width buttons with a right-aligned shortcut / detail. -->
  <Style x:Key="HomeRowButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
  </Style>
  <Style x:Key="HomeRowText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="HomeRowShortcut" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="16,0,0,0" />
  </Style>
  <Style x:Key="HomeListViewItem" TargetType="ListViewItem">
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
  </Style>

  <!-- Item page: horizontal strips (one row, sideways scroll) share this shape. -->
  <Style x:Key="StripGridView" TargetType="GridView">
    <Setter Property="SelectionMode" Value="None" />
    <Setter Property="IsItemClickEnabled" Value="True" />
    <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Enabled" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
    <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <ItemsWrapGrid Orientation="Vertical" MaximumRowsOrColumns="1" />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Pill toggles for server-side flags (played / favourite). -->
  <Style x:Key="ChipToggle" TargetType="ToggleButton">
    <Setter Property="Background" Value="{StaticResource HoverFillBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <!-- Version / audio / subtitle pickers under the play button: card-shaped drop-downs. -->
  <Style x:Key="MediaCardButton" TargetType="DropDownButton">
    <Setter Property="Background" Value="{StaticResource HoverFillBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Padding" Value="14,10,10,10" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <!-- Small round ‹ › pagers at the right of a strip's header. -->
  <Style x:Key="StripArrow" TargetType="Button" BasedOn="{StaticResource IconButton}">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="MinWidth" Value="28" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="{StaticResource HoverFillBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- Format chips: frosted grey pill around the format's white logo (FormatBadgeVisuals). -->
  <Style x:Key="BadgeChip" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BadgeBackdropBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BadgeEdgeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14,12" />
  </Style>
  <Style x:Key="BadgeText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CharacterSpacing" Value="12" />
  </Style>
  <!-- Title-bar variant: smaller, outlined, sits next to the media title. -->
  <Style x:Key="TitleBadgeChip" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource HoverFillBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="4,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="TitleBadgeText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="9.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="OsdPill" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource OsdBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
    <Setter Property="Padding" Value="18,8" />
    <Setter Property="MinHeight" Value="36" />
  </Style>

  <!-- Text hierarchy -->
  <Style x:Key="TitleText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="HeadlineText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="BodyText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style x:Key="SecondaryText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style x:Key="SectionHeaderText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CharacterSpacing" Value="80" />
  </Style>
  <Style x:Key="TimeText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Segoe UI" />
  </Style>
  <Style x:Key="MonoText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Segoe UI" />
    <Setter Property="LineHeight" Value="18" />
  </Style>
  <Style x:Key="OsdText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Pane list items: flat rows, no default reveal chrome. -->
  <Style x:Key="PaneListViewItem" TargetType="ListViewItem">
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="Margin" Value="0,1" />
  </Style>
</ResourceDictionary>
