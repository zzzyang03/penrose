<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MediaPlayer.App.WinUI</RootNamespace>
    <ApplicationTitle>Penrose</ApplicationTitle>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <WindowsAppSDKSelfContained Condition="'$(SelfContained)' == 'true'">true</WindowsAppSDKSelfContained>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Velopack" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>
  <ItemGroup>
    <!-- Premium-format logos for the transient chips (unpackaged: ms-appx:/// maps to the exe directory). -->
    <Content Include="Assets\AppIcon.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Badges\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Servers\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MediaPlayer.Core\MediaPlayer.Core.csproj" />
    <ProjectReference Include="..\MediaPlayer.Diagnostics\MediaPlayer.Diagnostics.csproj" />
    <ProjectReference Include="..\MediaPlayer.Interop.LibMpv\MediaPlayer.Interop.LibMpv.csproj" />
    <ProjectReference Include="..\MediaPlayer.Persistence\MediaPlayer.Persistence.csproj" />
    <ProjectReference Include="..\MediaPlayer.Playback.Mpv\MediaPlayer.Playback.Mpv.csproj" />
    <ProjectReference Include="..\MediaPlayer.Sources.Emby\MediaPlayer.Sources.Emby.csproj" />
    <ProjectReference Include="..\MediaPlayer.VideoSurface.Abstractions\MediaPlayer.VideoSurface.Abstractions.csproj" />
    <ProjectReference Include="..\MediaPlayer.VideoSurface.WinUI\MediaPlayer.VideoSurface.WinUI.csproj" />
  </ItemGroup>
  <Target Name="CopyDotnetRootLauncher" AfterTargets="Build" Condition="'$(SelfContained)' != 'true'">
    <Copy
      SourceFiles="$(MSBuildThisFileDirectory)..\..\scripts\start-app-local.cmd"
      DestinationFiles="$(OutputPath)启动.cmd"
      SkipUnchangedFiles="true" />
  </Target>
  <PropertyGroup>
    <LibMpvBin>$(RepoRoot)third_party\libmpv\bin\x64</LibMpvBin>
  </PropertyGroup>
  <Target Name="CopyLibMpv" AfterTargets="Build">
    <ItemGroup>
      <_MpvDll Include="$(LibMpvBin)\mpv-2.dll" Condition="Exists('$(LibMpvBin)\mpv-2.dll')" />
      <_MpvDll Include="$(LibMpvBin)\libmpv-2.dll" Condition="Exists('$(LibMpvBin)\libmpv-2.dll')" />
      <_MpvDll Include="$(LibMpvBin)\d3dcompiler_43.dll" Condition="Exists('$(LibMpvBin)\d3dcompiler_43.dll')" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_MpvDll)"
      DestinationFolder="$(OutputPath)"
      SkipUnchangedFiles="true"
      Condition="'@(_MpvDll)' != ''" />
  </Target>
  <Target Name="CopyLibMpvOnPublish" AfterTargets="Publish">
    <ItemGroup>
      <_MpvPub Include="$(LibMpvBin)\mpv-2.dll" Condition="Exists('$(LibMpvBin)\mpv-2.dll')" />
      <_MpvPub Include="$(LibMpvBin)\libmpv-2.dll" Condition="Exists('$(LibMpvBin)\libmpv-2.dll')" />
      <_MpvPub Include="$(LibMpvBin)\d3dcompiler_43.dll" Condition="Exists('$(LibMpvBin)\d3dcompiler_43.dll')" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_MpvPub)"
      DestinationFolder="$(PublishDir)"
      SkipUnchangedFiles="true"
      Condition="'@(_MpvPub)' != ''" />
  </Target>
</Project>
